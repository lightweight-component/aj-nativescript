{
  "name": "@ajax-js/nativescript-mqtt-v5",
  "version": "0.1.0",
  "description": "TypeScript package scaffold for MQTT integration in NativeScript 9",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "keywords": [
    "nativescript",
    "typescript",
    "mqtt"
  ],
  "peerDependencies": {
    "@nativescript/core": "^9.1.3"
  },
  "devDependencies": {
    "@nativescript/core": "~9.1.3",
    "@nativescript/types": "~9.1.4",
    "typescript": "~6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
